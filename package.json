{
  "name": "@gtk96/openviking-mcp",
  "version": "0.1.0",
  "description": "Minimal MCP server that exposes OpenViking knowledge retrieval to any MCP-capable agent, without automatic memory capture",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openviking-mcp": "./src/server.mjs"
  },
  "exports": {
    ".": "./src/server.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/"
  },
  "keywords": [
    "mcp",
    "openviking",
    "knowledge-base",
    "retrieval"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gtk96/openviking-mcp.git"
  }
}
